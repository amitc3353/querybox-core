# QueryBox Core - Demo Environment (Qdrant Cloud)
# This file is optimized for demo deployments using Qdrant Cloud free tier
# Copy to .env: cp .env.demo .env

# ============================================================================
# Environment
# ============================================================================
DEBUG=False
LOG_LEVEL=INFO
TESTING=False

# ============================================================================
# Database Configuration
# ============================================================================
DATABASE_URL=postgresql://querybox:CHANGE_ME_PRODUCTION_PASSWORD@your-db-host:5432/querybox_core

# ============================================================================
# Redis Configuration
# ============================================================================
REDIS_URL=redis://your-redis-host:6379/0

# ============================================================================
# S3/MinIO Storage Configuration
# ============================================================================
# For demo, you might use AWS S3 or keep MinIO
S3_ENDPOINT=http://your-minio-host:9000  # or s3.amazonaws.com for AWS
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_BUCKET_NAME=querybox-demo-documents
STORAGE_PROVIDER=minio  # or 's3' for AWS

# ============================================================================
# Celery Configuration
# ============================================================================
CELERY_BROKER_URL=redis://your-redis-host:6379/1
CELERY_RESULT_BACKEND=redis://your-redis-host:6379/2

# ============================================================================
# Modular Provider Configuration
# ============================================================================
PARSER_PRIMARY=docling
EMBEDDING_PROVIDER=bge-m3  # or 'openai' for better quality
VECTOR_STORE=pgvector  # Primary store with Qdrant Cloud as accelerator
LLM_PROVIDER=openrouter  # Recommended for demos (better quality than tinyllama)

# ============================================================================
# Phase 4: Qdrant Vector Store Configuration (CLOUD)
# ============================================================================
# Qdrant Cloud Setup Instructions:
# 1. Sign up at https://cloud.qdrant.io/
# 2. Create a free cluster (1GB storage, ~300K vectors)
# 3. Get your cluster URL from the dashboard
# 4. Generate an API key in cluster settings
# 5. Update the values below

ENABLE_QDRANT=true  # Enable hybrid mode (pgvector + Qdrant Cloud)
QDRANT_URL=https://your-cluster-name.cloud.qdrant.io:6333  # UPDATE THIS
QDRANT_API_KEY=your-qdrant-cloud-api-key-here  # UPDATE THIS
QDRANT_COLLECTION=querybox_demo_embeddings
QDRANT_PREFER_GRPC=false  # HTTP works well for cloud

# Performance settings (optimized for cloud)
QDRANT_BATCH_SIZE=500
QDRANT_TIMEOUT=10  # Longer timeout for cloud
QDRANT_SEARCH_TIMEOUT=3  # Longer search timeout for cloud
QDRANT_PARALLEL_UPLOAD=true

# Circuit breaker settings (more lenient for cloud latency)
QDRANT_CIRCUIT_FAILURE_THRESHOLD=10  # Allow more failures before circuit opens
QDRANT_CIRCUIT_COOLDOWN=60  # Longer cooldown for cloud
QDRANT_CIRCUIT_HALF_OPEN_REQUESTS=3

# HNSW settings (balanced for demo)
QDRANT_HNSW_M=16
QDRANT_HNSW_EF_CONSTRUCT=100
QDRANT_HNSW_EF_SEARCH=64
QDRANT_ON_DISK=false  # Free tier uses in-memory

# ============================================================================
# OpenRouter LLM Configuration (Recommended for Demo)
# ============================================================================
# Sign up at: https://openrouter.ai/
# Get API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here  # UPDATE THIS
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini  # Fast, affordable, high quality
OPENROUTER_APP_NAME=QueryBox Core Demo
OPENROUTER_SITE_URL=  # Optional

# Alternative models for demo:
# OPENROUTER_MODEL=google/gemini-2.0-flash-exp  # FREE during preview
# OPENROUTER_MODEL=anthropic/claude-3-haiku  # Fast, good quality

# ============================================================================
# OpenAI Configuration (Optional - for embeddings)
# ============================================================================
# If using EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here  # UPDATE THIS if using OpenAI embeddings
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSION=1536

# ============================================================================
# Ollama (Optional - if self-hosting LLM)
# ============================================================================
# If using LLM_PROVIDER=ollama on demo server
OLLAMA_BASE_URL=http://your-ollama-host:11434
OLLAMA_MODEL=tinyllama
OLLAMA_TIMEOUT=60

# ============================================================================
# BGE-M3 Embedding Configuration (Self-hosted)
# ============================================================================
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=cpu  # or 'cuda' if demo server has GPU
EMBEDDING_BATCH_SIZE=100

# ============================================================================
# Search Configuration
# ============================================================================
ENABLE_RERANKING=True
ENABLE_MMR=True
ENABLE_ADVANCED_DEDUP=True
VERIFICATION_ENABLED=True
VERIFICATION_LEVEL=HIGH

# ============================================================================
# API Configuration
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=CHANGE_ME_SECURE_DEMO_KEY
CORS_ORIGINS=https://your-demo-frontend.com,https://demo.querybox.ai

# ============================================================================
# Security
# ============================================================================
SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET_KEY_FOR_DEMO

# ============================================================================
# Monitoring & Logging
# ============================================================================
ENABLE_PROMETHEUS=True
LOGTAIL_ENABLED=True  # Enable for demo monitoring
LOGTAIL_SOURCE_TOKEN=your-logtail-token-here  # UPDATE THIS for logging
SENTRY_DSN=  # Optional: Add Sentry for error tracking

# ============================================================================
# Performance
# ============================================================================
# Enable GPU acceleration if demo server has GPU
CROSS_ENCODER_DEVICE=cpu  # or 'cuda'
