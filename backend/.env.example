# QueryBox Core Backend - Environment Configuration
# Copy this file to .env and update with your actual values

# ============================================================================
# Database Configuration
# ============================================================================
DATABASE_URL=postgresql://querybox:password@localhost:5432/querybox
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ============================================================================
# Redis Configuration
# ============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0

# ============================================================================
# S3/MinIO Storage Configuration
# ============================================================================
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=querybox-documents
S3_REGION=us-east-1
STORAGE_PROVIDER=minio  # "s3" or "minio" or "local"

# ============================================================================
# HuggingFace Tokenizers
# ============================================================================
# Disable parallelism warning when forking with Celery
TOKENIZERS_PARALLELISM=false

# ============================================================================
# Celery Configuration
# ============================================================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ============================================================================
# API Configuration
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=dev-api-key-12345
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
DEBUG=True
LOG_LEVEL=INFO

# ============================================================================
# Modular Provider Configuration (Enables swapping components via config)
# ============================================================================

# Parser Selection
# Controls which document parser is used for extracting text from uploaded files.
# Options:
#   - "docling": IBM Docling (default) - Best for PDFs with OCR fallback
#   - "mineru": MinerU - Best for tables and scientific documents
#   - "unstructured": Unstructured.io - Multi-format support
#   - "smart": Intelligent router that selects best parser per document type
PARSER_PRIMARY=docling

# Embedding Provider Selection
# Controls which service generates vector embeddings for semantic search.
# Options:
#   - "bge-m3": BGE-M3 local model (default) - Free, 1024-dim, runs locally
#   - "bge": Alias for bge-m3
#   - "openai": OpenAI text-embedding-3-large - Best quality, 3072-dim, API cost
#   - "cohere": Cohere embed-v3 - Multilingual, 1024-dim, API cost
#   - "voyage": Voyage AI - High quality, 1024-dim, API cost
EMBEDDING_PROVIDER=bge-m3

# Vector Store Selection
# Controls which database stores and searches vector embeddings.
# Options:
#   - "pgvector": PostgreSQL + pgvector (default) - Free, integrated with main DB
#   - "qdrant": Qdrant - 10x faster search, requires separate service
#   - "lancedb": LanceDB - Embedded, serverless, good for prototyping
#   - "weaviate": Weaviate - Cloud-native, advanced features
VECTOR_STORE=pgvector

# LLM Provider Selection
# Controls which language model generates answers from retrieved context.
# Options:
#   - "ollama": Ollama (default) - Free, runs locally, models like tinyllama/qwen2
#   - "openrouter": OpenRouter - Access to GPT-4o-mini, Claude, etc via unified API
#   - "openai": OpenAI - Direct access to GPT-4, GPT-4o-mini
#   - "claude": Anthropic Claude - Claude 3.5 Sonnet, Haiku, Opus
LLM_PROVIDER=ollama

# ============================================================================
# Embedding Configuration (Step 9.2)
# ============================================================================
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=cpu  # "cpu" or "cuda" for GPU
EMBEDDING_BATCH_SIZE=100
EMBEDDING_MAX_LENGTH=512
EMBEDDING_NORMALIZE=True

# ============================================================================
# Step 10.2: Cross-Encoder Reranking Configuration
# ============================================================================

# Cross-Encoder Model Settings
CROSS_ENCODER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L6-v2
CROSS_ENCODER_DEVICE=cpu  # "cpu" or "cuda" for GPU acceleration
CROSS_ENCODER_BATCH_SIZE=32
CROSS_ENCODER_MAX_LENGTH=512
CROSS_ENCODER_NUM_THREADS=4
CROSS_ENCODER_CACHE_SIZE=1000

# Enable/Disable Reranking
ENABLE_RERANKING=True  # Master switch for reranking pipeline

# ============================================================================
# Step 10.2: MMR (Maximal Marginal Relevance) Configuration
# ============================================================================

# MMR Settings
ENABLE_MMR=True  # Enable MMR diversification
MMR_LAMBDA=0.7  # Balance between relevance (1.0) and diversity (0.0)
MMR_MIN_LAMBDA=0.0  # Minimum allowed lambda value
MMR_MAX_LAMBDA=1.0  # Maximum allowed lambda value
MMR_MIN_CANDIDATES=10  # Minimum candidates required for MMR

# ============================================================================
# Step 10.2: Deduplication Configuration
# ============================================================================

# Deduplication Settings
ENABLE_ADVANCED_DEDUP=True  # Enable advanced 3-stage deduplication
ENABLE_SEMANTIC_DEDUP=True  # Enable semantic embedding-based deduplication
SEMANTIC_DEDUP_THRESHOLD=0.95  # Similarity threshold for semantic dedup (0.80-0.99)
SEMANTIC_DEDUP_MIN_THRESHOLD=0.80  # Minimum allowed threshold
SEMANTIC_DEDUP_MAX_THRESHOLD=0.99  # Maximum allowed threshold

# ============================================================================
# Step 10.2: Reranking Pipeline Configuration
# ============================================================================

# Pipeline Stage Controls
RERANKING_STAGE_1_ENABLED=True  # Enable cross-encoder reranking stage
RERANKING_STAGE_2_ENABLED=True  # Enable deduplication stage
RERANKING_STAGE_3_ENABLED=True  # Enable MMR stage

# Performance & Error Handling
RERANKING_TIMEOUT_MS=3000  # Maximum time for reranking operation (milliseconds)
RERANKING_MAX_RETRIES=1  # Number of retries on failure

# ============================================================================
# Step 10.2: Rate Limiting & Concurrency (Phase 5)
# ============================================================================

# Rate Limiting
RATE_LIMIT_RERANKING=10/minute  # Rate limit for reranking requests
MAX_CONCURRENT_RERANKING=5  # Maximum concurrent reranking operations

# ============================================================================
# Step 10.2: Monitoring & Logging (Phase 5)
# ============================================================================

# Logging Configuration
RERANKING_LOG_LEVEL=INFO  # Logging level for reranking operations
LOG_SLOW_RERANKING=True  # Log slow reranking requests
SLOW_RERANKING_THRESHOLD_MS=300  # Threshold for logging slow requests (milliseconds)

# Metrics & Monitoring
ENABLE_RERANKING_METRICS=True  # Enable Prometheus metrics for reranking
TRACK_MMR_DIVERSITY=True  # Track MMR diversity scores in metrics
TRACK_DEDUP_STATS=True  # Track deduplication statistics in metrics

# ============================================================================
# Step 10.2: A/B Testing Configuration (Optional)
# ============================================================================

# A/B Testing
RERANKING_AB_TEST_ENABLED=False  # Enable A/B testing for reranking
RERANKING_AB_TEST_RATIO=0.5  # Ratio of requests to use reranking (0.0-1.0)

# ============================================================================
# Search Configuration
# ============================================================================

# Search Performance
SEARCH_MAX_RESULTS=100
SEARCH_DEFAULT_LIMIT=10
VECTOR_SEARCH_TOP_K=100
KEYWORD_SEARCH_TOP_K=100

# Hybrid Search (Step 10.1)
HYBRID_KEYWORD_WEIGHT=0.5
HYBRID_VECTOR_WEIGHT=0.5
HYBRID_ENABLE_RRF=True  # Reciprocal Rank Fusion

# ============================================================================
# Step 11.2: Chain-of-Verification Configuration
# ============================================================================

# Verification Level (Controls all verification parameters)
# Options: VERY_HIGH, HIGH, MEDIUM, LOW, VERY_LOW
# - VERY_HIGH: Maximum strictness for legal/medical domains (>98% accuracy, highest abstention rate)
# - HIGH: Production default (>95% accuracy) - RECOMMENDED
# - MEDIUM: Balanced for internal tools (>90% accuracy, moderate strictness)
# - LOW: Lenient for exploratory queries (>85% accuracy, low abstention rate)
# - VERY_LOW: Minimal verification for speed-critical apps (>80% accuracy, almost never abstains)
VERIFICATION_LEVEL=HIGH

# Verification Feature Flags
VERIFICATION_ENABLED=True  # Global enable/disable for verification
VERIFICATION_DEFAULT_ON=False  # Default for API requests (opt-in vs opt-out)

# Feature-specific flags (controlled by profile, can override if needed)
ENABLE_QUOTE_MATCHING=True
ENABLE_VERIFICATION_QUESTIONS=True
ENABLE_HALLUCINATION_DETECTION=True
ENABLE_CONTRADICTION_CHECK=True  # LLM-based contradiction detection (can disable for speed)

# Performance Tuning
VERIFICATION_TIMEOUT_SECONDS=120  # Total verification timeout
VERIFICATION_QUESTION_TIMEOUT=60  # Per-question timeout
VERIFICATION_MAX_QUESTIONS=10  # Prevent DOS attacks
VERIFICATION_MAX_PROPOSITIONS=10  # Limit proposition count

# Caching Strategy (3-level)
VERIFICATION_CACHE_TTL_SECONDS=3600  # L1: Verification results (1 hour)
QUOTE_MATCH_CACHE_TTL_SECONDS=86400  # L2: Quote matches (24 hours)
VERIFICATION_QUESTION_CACHE_TTL_SECONDS=604800  # L3: Verification questions (1 week)

# Rate Limiting - Verification
VERIFICATION_RATE_LIMIT_PER_MINUTE=5  # Verified answers per minute
VERIFICATION_RATE_LIMIT_PER_HOUR=50  # Hourly limit

# Resource Limits
MAX_CONCURRENT_VERIFICATIONS=10  # Redis-based semaphore
MAX_CONCURRENT_QUOTE_MATCHES=20  # Per verification
MAX_CONCURRENT_LLM_CALLS=5  # Per verification
MAX_VERIFICATION_MEMORY_MB=100  # Per request

# Monitoring - Verification
ENABLE_VERIFICATION_METRICS=True
LOG_VERIFICATION_RESULTS=True
TRACK_HALLUCINATION_TRENDS=True

# ============================================================================
# Application Settings
# ============================================================================

# File Upload
MAX_UPLOAD_SIZE=31457280  # 30MB in bytes
ALLOWED_FILE_TYPES=.pdf,.docx,.xlsx,.pptx,.txt,.md,.html

# Document Processing
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MIN_CHUNK_SIZE=100

# Security
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================================
# Development Settings
# ============================================================================

# Testing
TESTING=False
TEST_DATABASE_URL=postgresql://querybox:password@localhost:5432/querybox_test

# Monitoring
SENTRY_DSN=  # Optional: Add Sentry DSN for error tracking
ENABLE_PROMETHEUS=True  # Enable Prometheus metrics endpoint

# ============================================================================
# Step 13.5: Better Stack (Logtail) Logging Configuration
# ============================================================================
LOGTAIL_SOURCE_TOKEN=  # Better Stack source token for centralized logging
LOGTAIL_HOST=in.logs.betterstack.com  # US endpoint (default) or EU: s{source_id}.eu-nbg-2.betterstackdata.com
LOGTAIL_ENABLED=True  # Enable/disable Better Stack logging

# ============================================================================
# Production Settings (Override in production)
# ============================================================================

# In production, set these values:
# DEBUG=False
# LOG_LEVEL=WARNING
# CROSS_ENCODER_DEVICE=cuda  # If GPU available
# EMBEDDING_DEVICE=cuda  # If GPU available
# ENABLE_RERANKING_METRICS=True
# SENTRY_DSN=https://your-sentry-dsn
