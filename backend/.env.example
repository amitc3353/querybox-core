# QueryBox Core Backend - Environment Configuration
# Copy this file to .env and update with your actual values

# ============================================================================
# Database Configuration
# ============================================================================
DATABASE_URL=postgresql://querybox:password@localhost:5432/querybox
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ============================================================================
# Redis Configuration
# ============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0

# ============================================================================
# S3/MinIO Storage Configuration
# ============================================================================
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=querybox-documents
S3_REGION=us-east-1
STORAGE_PROVIDER=minio  # "s3" or "minio" or "local"

# ============================================================================
# Celery Configuration
# ============================================================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ============================================================================
# API Configuration
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=dev-api-key-12345
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
DEBUG=True
LOG_LEVEL=INFO

# ============================================================================
# Embedding Configuration (Step 9.2)
# ============================================================================
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=cpu  # "cpu" or "cuda" for GPU
EMBEDDING_BATCH_SIZE=100
EMBEDDING_MAX_LENGTH=512
EMBEDDING_NORMALIZE=True

# ============================================================================
# Step 10.2: Cross-Encoder Reranking Configuration
# ============================================================================

# Cross-Encoder Model Settings
CROSS_ENCODER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L6-v2
CROSS_ENCODER_DEVICE=cpu  # "cpu" or "cuda" for GPU acceleration
CROSS_ENCODER_BATCH_SIZE=32
CROSS_ENCODER_MAX_LENGTH=512
CROSS_ENCODER_NUM_THREADS=4
CROSS_ENCODER_CACHE_SIZE=1000

# Enable/Disable Reranking
ENABLE_RERANKING=True  # Master switch for reranking pipeline

# ============================================================================
# Step 10.2: MMR (Maximal Marginal Relevance) Configuration
# ============================================================================

# MMR Settings
ENABLE_MMR=True  # Enable MMR diversification
MMR_LAMBDA=0.7  # Balance between relevance (1.0) and diversity (0.0)
MMR_MIN_LAMBDA=0.0  # Minimum allowed lambda value
MMR_MAX_LAMBDA=1.0  # Maximum allowed lambda value
MMR_MIN_CANDIDATES=10  # Minimum candidates required for MMR

# ============================================================================
# Step 10.2: Deduplication Configuration
# ============================================================================

# Deduplication Settings
ENABLE_ADVANCED_DEDUP=True  # Enable advanced 3-stage deduplication
ENABLE_SEMANTIC_DEDUP=True  # Enable semantic embedding-based deduplication
SEMANTIC_DEDUP_THRESHOLD=0.95  # Similarity threshold for semantic dedup (0.80-0.99)
SEMANTIC_DEDUP_MIN_THRESHOLD=0.80  # Minimum allowed threshold
SEMANTIC_DEDUP_MAX_THRESHOLD=0.99  # Maximum allowed threshold

# ============================================================================
# Step 10.2: Reranking Pipeline Configuration
# ============================================================================

# Pipeline Stage Controls
RERANKING_STAGE_1_ENABLED=True  # Enable cross-encoder reranking stage
RERANKING_STAGE_2_ENABLED=True  # Enable deduplication stage
RERANKING_STAGE_3_ENABLED=True  # Enable MMR stage

# Performance & Error Handling
RERANKING_TIMEOUT_MS=3000  # Maximum time for reranking operation (milliseconds)
RERANKING_MAX_RETRIES=1  # Number of retries on failure

# ============================================================================
# Step 10.2: Rate Limiting & Concurrency (Phase 5)
# ============================================================================

# Rate Limiting
RATE_LIMIT_RERANKING=10/minute  # Rate limit for reranking requests
MAX_CONCURRENT_RERANKING=5  # Maximum concurrent reranking operations

# ============================================================================
# Step 10.2: Monitoring & Logging (Phase 5)
# ============================================================================

# Logging Configuration
RERANKING_LOG_LEVEL=INFO  # Logging level for reranking operations
LOG_SLOW_RERANKING=True  # Log slow reranking requests
SLOW_RERANKING_THRESHOLD_MS=300  # Threshold for logging slow requests (milliseconds)

# Metrics & Monitoring
ENABLE_RERANKING_METRICS=True  # Enable Prometheus metrics for reranking
TRACK_MMR_DIVERSITY=True  # Track MMR diversity scores in metrics
TRACK_DEDUP_STATS=True  # Track deduplication statistics in metrics

# ============================================================================
# Step 10.2: A/B Testing Configuration (Optional)
# ============================================================================

# A/B Testing
RERANKING_AB_TEST_ENABLED=False  # Enable A/B testing for reranking
RERANKING_AB_TEST_RATIO=0.5  # Ratio of requests to use reranking (0.0-1.0)

# ============================================================================
# Search Configuration
# ============================================================================

# Search Performance
SEARCH_MAX_RESULTS=100
SEARCH_DEFAULT_LIMIT=10
VECTOR_SEARCH_TOP_K=100
KEYWORD_SEARCH_TOP_K=100

# Hybrid Search (Step 10.1)
HYBRID_KEYWORD_WEIGHT=0.5
HYBRID_VECTOR_WEIGHT=0.5
HYBRID_ENABLE_RRF=True  # Reciprocal Rank Fusion

# ============================================================================
# Application Settings
# ============================================================================

# File Upload
MAX_UPLOAD_SIZE=31457280  # 30MB in bytes
ALLOWED_FILE_TYPES=.pdf,.docx,.xlsx,.pptx,.txt,.md,.html

# Document Processing
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MIN_CHUNK_SIZE=100

# Security
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================================
# Development Settings
# ============================================================================

# Testing
TESTING=False
TEST_DATABASE_URL=postgresql://querybox:password@localhost:5432/querybox_test

# Monitoring
SENTRY_DSN=  # Optional: Add Sentry DSN for error tracking
ENABLE_PROMETHEUS=True  # Enable Prometheus metrics endpoint

# ============================================================================
# Production Settings (Override in production)
# ============================================================================

# In production, set these values:
# DEBUG=False
# LOG_LEVEL=WARNING
# CROSS_ENCODER_DEVICE=cuda  # If GPU available
# EMBEDDING_DEVICE=cuda  # If GPU available
# ENABLE_RERANKING_METRICS=True
# SENTRY_DSN=https://your-sentry-dsn
