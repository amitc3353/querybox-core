# QueryBox Core Backend - Environment Configuration
# Copy this file to .env and update with your actual values

# ============================================================================
# Database Configuration
# ============================================================================
DATABASE_URL=postgresql://querybox:password@localhost:5432/querybox
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ============================================================================
# Redis Configuration
# ============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0

# ============================================================================
# S3/MinIO Storage Configuration
# ============================================================================
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=querybox-documents
S3_REGION=us-east-1
STORAGE_PROVIDER=minio  # "s3" or "minio" or "local"

# ============================================================================
# HuggingFace Tokenizers
# ============================================================================
# Disable parallelism warning when forking with Celery
TOKENIZERS_PARALLELISM=false

# ============================================================================
# Celery Configuration
# ============================================================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ============================================================================
# API Configuration
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=dev-api-key-12345
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
DEBUG=True
LOG_LEVEL=INFO

# ============================================================================
# Modular Provider Configuration (Enables swapping components via config)
# ============================================================================

# Parser Selection
# Controls which document parser is used for extracting text from uploaded files.
# Options:
#   - "docling": IBM Docling (default) - Best for PDFs with OCR fallback
#   - "mineru": MinerU - Best for tables and scientific documents
#   - "unstructured": Unstructured.io - Multi-format support
#   - "smart": Intelligent router that selects best parser per document type
PARSER_PRIMARY=docling

# Embedding Provider Selection
# Controls which service generates vector embeddings for semantic search.
# Options:
#   - "bge-m3": BGE-M3 local model (default) - Free, 1024-dim, runs locally
#   - "bge": Alias for bge-m3
#   - "openai": OpenAI text-embedding-3-large - Best quality, 3072-dim, API cost
#   - "cohere": Cohere embed-v3 - Multilingual, 1024-dim, API cost
#   - "voyage": Voyage AI - High quality, 1024-dim, API cost
EMBEDDING_PROVIDER=bge-m3

# Vector Store Selection
# Controls which database stores and searches vector embeddings.
# Options:
#   - "pgvector": PostgreSQL + pgvector (default) - Free, integrated with main DB
#   - "qdrant": Qdrant - 10x faster search, requires separate service
#   - "lancedb": LanceDB - Embedded, serverless, good for prototyping
#   - "weaviate": Weaviate - Cloud-native, advanced features
VECTOR_STORE=pgvector

# LLM Provider Selection
# Controls which language model generates answers from retrieved context.
# Options:
#   - "ollama": Ollama (default) - Free, runs locally, models like tinyllama/qwen2
#   - "openrouter": OpenRouter - Access to GPT-4o-mini, Claude, etc via unified API
#   - "openai": OpenAI - Direct access to GPT-4, GPT-4o-mini
#   - "claude": Anthropic Claude - Claude 3.5 Sonnet, Haiku, Opus
LLM_PROVIDER=ollama

# ============================================================================
# Embedding Configuration (Step 9.2)
# ============================================================================
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=cpu  # "cpu" or "cuda" for GPU
EMBEDDING_BATCH_SIZE=100
EMBEDDING_MAX_LENGTH=512
EMBEDDING_NORMALIZE=True

# ============================================================================
# OpenRouter LLM Configuration (Phase 3)
# ============================================================================
# OpenRouter provides unified API access to multiple LLM providers:
# - OpenAI (GPT-4o, GPT-4o-mini)
# - Anthropic (Claude 3.5 Sonnet, Claude 3 Haiku)
# - Google (Gemini 2.0 Flash)
# - Meta (Llama 3.1 models)
#
# Sign up at: https://openrouter.ai/
# Get API key from: https://openrouter.ai/keys
#
# To use OpenRouter, set LLM_PROVIDER=openrouter above and add your API key below

OPENROUTER_API_KEY=  # Your OpenRouter API key (sk-or-v1-...)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini  # Recommended: Fast, affordable, high quality
OPENROUTER_APP_NAME=QueryBox Core
OPENROUTER_SITE_URL=  # Optional: Your site URL for OpenRouter rankings

# Available Models (uncomment to use):
# OPENROUTER_MODEL=openai/gpt-4o-mini  # $0.15/$0.60 per 1M tokens (RECOMMENDED)
# OPENROUTER_MODEL=openai/gpt-4o  # $2.50/$10.00 per 1M tokens (highest quality)
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet  # $3/$15 per 1M tokens (200k context)
# OPENROUTER_MODEL=anthropic/claude-3-haiku  # $0.25/$1.25 per 1M tokens (fastest)
# OPENROUTER_MODEL=google/gemini-2.0-flash-exp  # FREE during preview (1M context)
# OPENROUTER_MODEL=meta-llama/llama-3.1-405b  # $2.70 per 1M tokens (open source)

# ============================================================================
# OpenAI API Configuration (Phase 3)
# ============================================================================
# OpenAI API is used for:
# 1. Direct OpenAI embeddings (text-embedding-3-large, text-embedding-3-small)
# 2. Optional: Direct GPT access (if using LLM_PROVIDER=openai instead of openrouter)
#
# Sign up at: https://platform.openai.com/
# Get API key from: https://platform.openai.com/api-keys
#
# To use OpenAI embeddings, set EMBEDDING_PROVIDER=openai above

OPENAI_API_KEY=  # Your OpenAI API key (sk-...)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small  # or text-embedding-3-large
OPENAI_EMBEDDING_DIMENSION=1536  # 1536 for small, 3072 for large
OPENAI_EMBEDDING_BATCH_SIZE=100  # Number of texts to embed in one API call

# Embedding Model Options:
# - text-embedding-3-small: 1536-dim, $0.02 per 1M tokens (RECOMMENDED)
# - text-embedding-3-large: 3072-dim, $0.13 per 1M tokens (highest quality)
# - text-embedding-ada-002: 1536-dim, $0.10 per 1M tokens (legacy)

# ============================================================================
# Step 10.2: Cross-Encoder Reranking Configuration
# ============================================================================

# Cross-Encoder Model Settings
CROSS_ENCODER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L6-v2
CROSS_ENCODER_DEVICE=cpu  # "cpu" or "cuda" for GPU acceleration
CROSS_ENCODER_BATCH_SIZE=32
CROSS_ENCODER_MAX_LENGTH=512
CROSS_ENCODER_NUM_THREADS=4
CROSS_ENCODER_CACHE_SIZE=1000

# Enable/Disable Reranking
ENABLE_RERANKING=True  # Master switch for reranking pipeline

# ============================================================================
# Step 10.2: MMR (Maximal Marginal Relevance) Configuration
# ============================================================================

# MMR Settings
ENABLE_MMR=True  # Enable MMR diversification
MMR_LAMBDA=0.7  # Balance between relevance (1.0) and diversity (0.0)
MMR_MIN_LAMBDA=0.0  # Minimum allowed lambda value
MMR_MAX_LAMBDA=1.0  # Maximum allowed lambda value
MMR_MIN_CANDIDATES=10  # Minimum candidates required for MMR

# ============================================================================
# Step 10.2: Deduplication Configuration
# ============================================================================

# Deduplication Settings
ENABLE_ADVANCED_DEDUP=True  # Enable advanced 3-stage deduplication
ENABLE_SEMANTIC_DEDUP=True  # Enable semantic embedding-based deduplication
SEMANTIC_DEDUP_THRESHOLD=0.95  # Similarity threshold for semantic dedup (0.80-0.99)
SEMANTIC_DEDUP_MIN_THRESHOLD=0.80  # Minimum allowed threshold
SEMANTIC_DEDUP_MAX_THRESHOLD=0.99  # Maximum allowed threshold

# ============================================================================
# Step 10.2: Reranking Pipeline Configuration
# ============================================================================

# Pipeline Stage Controls
RERANKING_STAGE_1_ENABLED=True  # Enable cross-encoder reranking stage
RERANKING_STAGE_2_ENABLED=True  # Enable deduplication stage
RERANKING_STAGE_3_ENABLED=True  # Enable MMR stage

# Performance & Error Handling
RERANKING_TIMEOUT_MS=3000  # Maximum time for reranking operation (milliseconds)
RERANKING_MAX_RETRIES=1  # Number of retries on failure

# ============================================================================
# Step 10.2: Rate Limiting & Concurrency (Phase 5)
# ============================================================================

# Rate Limiting
RATE_LIMIT_RERANKING=10/minute  # Rate limit for reranking requests
MAX_CONCURRENT_RERANKING=5  # Maximum concurrent reranking operations

# ============================================================================
# Step 10.2: Monitoring & Logging (Phase 5)
# ============================================================================

# Logging Configuration
RERANKING_LOG_LEVEL=INFO  # Logging level for reranking operations
LOG_SLOW_RERANKING=True  # Log slow reranking requests
SLOW_RERANKING_THRESHOLD_MS=300  # Threshold for logging slow requests (milliseconds)

# Metrics & Monitoring
ENABLE_RERANKING_METRICS=True  # Enable Prometheus metrics for reranking
TRACK_MMR_DIVERSITY=True  # Track MMR diversity scores in metrics
TRACK_DEDUP_STATS=True  # Track deduplication statistics in metrics

# ============================================================================
# Step 10.2: A/B Testing Configuration (Optional)
# ============================================================================

# A/B Testing
RERANKING_AB_TEST_ENABLED=False  # Enable A/B testing for reranking
RERANKING_AB_TEST_RATIO=0.5  # Ratio of requests to use reranking (0.0-1.0)

# ============================================================================
# Search Configuration
# ============================================================================

# Search Performance
SEARCH_MAX_RESULTS=100
SEARCH_DEFAULT_LIMIT=10
VECTOR_SEARCH_TOP_K=100
KEYWORD_SEARCH_TOP_K=100

# Hybrid Search (Step 10.1)
HYBRID_KEYWORD_WEIGHT=0.5
HYBRID_VECTOR_WEIGHT=0.5
HYBRID_ENABLE_RRF=True  # Reciprocal Rank Fusion

# ============================================================================
# Step 11.2: Chain-of-Verification Configuration
# ============================================================================

# Verification Level (Controls all verification parameters)
# Options: VERY_HIGH, HIGH, MEDIUM, LOW, VERY_LOW
# - VERY_HIGH: Maximum strictness for legal/medical domains (>98% accuracy, highest abstention rate)
# - HIGH: Production default (>95% accuracy) - RECOMMENDED
# - MEDIUM: Balanced for internal tools (>90% accuracy, moderate strictness)
# - LOW: Lenient for exploratory queries (>85% accuracy, low abstention rate)
# - VERY_LOW: Minimal verification for speed-critical apps (>80% accuracy, almost never abstains)
VERIFICATION_LEVEL=HIGH

# Verification Feature Flags
VERIFICATION_ENABLED=True  # Global enable/disable for verification
VERIFICATION_DEFAULT_ON=False  # Default for API requests (opt-in vs opt-out)

# Feature-specific flags (controlled by profile, can override if needed)
ENABLE_QUOTE_MATCHING=True
ENABLE_VERIFICATION_QUESTIONS=True
ENABLE_HALLUCINATION_DETECTION=True
ENABLE_CONTRADICTION_CHECK=True  # LLM-based contradiction detection (can disable for speed)

# Performance Tuning
VERIFICATION_TIMEOUT_SECONDS=120  # Total verification timeout
VERIFICATION_QUESTION_TIMEOUT=60  # Per-question timeout
VERIFICATION_MAX_QUESTIONS=10  # Prevent DOS attacks
VERIFICATION_MAX_PROPOSITIONS=10  # Limit proposition count

# Caching Strategy (3-level)
VERIFICATION_CACHE_TTL_SECONDS=3600  # L1: Verification results (1 hour)
QUOTE_MATCH_CACHE_TTL_SECONDS=86400  # L2: Quote matches (24 hours)
VERIFICATION_QUESTION_CACHE_TTL_SECONDS=604800  # L3: Verification questions (1 week)

# Rate Limiting - Verification
VERIFICATION_RATE_LIMIT_PER_MINUTE=5  # Verified answers per minute
VERIFICATION_RATE_LIMIT_PER_HOUR=50  # Hourly limit

# Resource Limits
MAX_CONCURRENT_VERIFICATIONS=10  # Redis-based semaphore
MAX_CONCURRENT_QUOTE_MATCHES=20  # Per verification
MAX_CONCURRENT_LLM_CALLS=5  # Per verification
MAX_VERIFICATION_MEMORY_MB=100  # Per request

# Monitoring - Verification
ENABLE_VERIFICATION_METRICS=True
LOG_VERIFICATION_RESULTS=True
TRACK_HALLUCINATION_TRENDS=True

# ============================================================================
# Application Settings
# ============================================================================

# File Upload
MAX_UPLOAD_SIZE=31457280  # 30MB in bytes
ALLOWED_FILE_TYPES=.pdf,.docx,.xlsx,.pptx,.txt,.md,.html

# Document Processing
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MIN_CHUNK_SIZE=100

# Security
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================================
# Development Settings
# ============================================================================

# Testing
TESTING=False
TEST_DATABASE_URL=postgresql://querybox:password@localhost:5432/querybox_test

# Monitoring
SENTRY_DSN=  # Optional: Add Sentry DSN for error tracking
ENABLE_PROMETHEUS=True  # Enable Prometheus metrics endpoint

# ============================================================================
# Step 13.5: Better Stack (Logtail) Logging Configuration
# ============================================================================
LOGTAIL_SOURCE_TOKEN=  # Better Stack source token for centralized logging
LOGTAIL_HOST=in.logs.betterstack.com  # US endpoint (default) or EU: s{source_id}.eu-nbg-2.betterstackdata.com
LOGTAIL_ENABLED=True  # Enable/disable Better Stack logging

# ============================================================================
# Phase 2.1: Docling Parser Optimization
# ============================================================================
# Phase 2.1 optimizes the Docling parser with GPU support, parallel processing,
# and model preloading for 30-50% speed improvement on CPU (10x with GPU).

# Device Selection
# Controls which compute device is used for parsing
# Options: "auto" (detect best), "cpu" (force CPU), "cuda" (NVIDIA GPU), "mps" (Apple Silicon)
DOCLING_DEVICE=auto
DOCLING_ENABLE_MPS=False  # Apple Silicon GPU (experimental, disabled due to EasyOCR compatibility)
DOCLING_NUM_THREADS=8  # CPU threads for parallel processing (4-16 recommended)

# Parallel Processing (ThreadedPdfPipeline)
# ThreadedPdfPipeline enables 5-stage concurrent processing:
# 1. Preprocessing → 2. OCR → 3. Layout Analysis → 4. Table Extraction → 5. Assembly
DOCLING_USE_THREADED_PIPELINE=True  # Enable parallel pipeline (recommended for multi-core CPUs)
DOCLING_OCR_BATCH_SIZE=4  # EasyOCR batch size: 4 for CPU, 64 for GPU
DOCLING_LAYOUT_BATCH_SIZE=4  # Layout model batch size: 4 for CPU, 64 for GPU
DOCLING_TABLE_BATCH_SIZE=4  # Table extraction batch size: 4 for CPU, 64 for GPU

# Model Loading Strategy
# Eager initialization preloads models on startup to avoid first-request latency
DOCLING_EAGER_INIT=True  # Initialize models on service startup (adds 5-10s to startup)
DOCLING_WARMUP_ON_STARTUP=True  # Warm up models with dummy PDF (adds 2-3s to startup)

# Large PDF Handling (100+ pages)
# Batch processing reduces memory usage for large documents
DOCLING_PAGE_BATCH_SIZE=50  # Pages per batch (50-100 recommended)
DOCLING_MAX_PAGES_MEMORY_THRESHOLD=100  # Switch to batch mode above this page count

# Performance Tuning
DOCLING_ENABLE_PERFORMANCE_LOGGING=True  # Log detailed performance metrics (timing, memory)
DOCLING_LOG_GPU_MEMORY=True  # Log GPU memory usage (only if GPU available)

# Deployment Scenarios:
#
# Development (CPU-only, M3 Max):
#   DOCLING_DEVICE=cpu
#   DOCLING_USE_THREADED_PIPELINE=True
#   DOCLING_NUM_THREADS=8
#   Expected: 1.27s/page → 0.85s/page (30% improvement)
#
# Production (NVIDIA GPU):
#   DOCLING_DEVICE=cuda
#   DOCLING_USE_THREADED_PIPELINE=True
#   DOCLING_OCR_BATCH_SIZE=64
#   DOCLING_LAYOUT_BATCH_SIZE=64
#   Expected: 1.27s/page → 0.15s/page (10x improvement)
#
# Apple Silicon (Experimental):
#   DOCLING_DEVICE=mps
#   DOCLING_ENABLE_MPS=True
#   Note: EasyOCR has compatibility issues with MPS, may fallback to CPU

# ============================================================================
# Phase 2.4: Vision API Configuration (GPT-4o-mini for Chart Interpretation)
# ============================================================================
# Vision API interprets charts, graphs, and visual elements that text parsers cannot handle.
# Cost: ~$0.0005 per image ($0.005 per 10-chart document with gpt-4o-mini)

# Enable/Disable Vision Processing
ENABLE_VISION_PARSING=True  # Master switch for vision API
VISION_PARSE_IMAGES_IN_DOCS=True  # Extract and interpret images from documents

# Vision API Model Selection
# Options:
#   - gpt-4o-mini: Fast, affordable ($0.0005/image) - RECOMMENDED
#   - gpt-4o: Higher quality ($0.002/image)
#   - gpt-4-vision-preview: Legacy model
VISION_API_MODEL=gpt-4o-mini
VISION_API_MAX_TOKENS=500  # Max tokens for vision response
VISION_API_TEMPERATURE=0.2  # Lower = more deterministic (0.0-1.0)

# Image Processing
VISION_API_MAX_IMAGES_PER_DOC=20  # Max images per document (cost control)
VISION_IMAGE_MAX_SIZE=2048  # Max dimension in pixels
VISION_IMAGE_QUALITY=auto  # Options: auto, low, high

# Cost Tracking
VISION_ENABLE_COST_TRACKING=True  # Track API usage and costs
VISION_COST_PER_IMAGE=0.0005  # Estimated cost per image (gpt-4o-mini)
VISION_MAX_COST_PER_DOC=0.10  # Max spend per document ($0.10 = 200 images)
VISION_WARN_COST_THRESHOLD=0.05  # Warn if cost exceeds this

# Performance
VISION_API_TIMEOUT_SECONDS=30  # Timeout for API calls
VISION_API_MAX_RETRIES=2  # Retries on failure
VISION_ENABLE_CACHING=True  # Cache results (avoid reprocessing)
VISION_CACHE_TTL_SECONDS=86400  # 24 hours cache

# Cost Estimates (gpt-4o-mini):
#   - 10 charts/doc: ~$0.005
#   - 100 docs with 10 charts: ~$0.50
#   - 10,000 docs with 10 charts: ~$50/month

# ============================================================================
# Smart Router Configuration (Phase 2.3)
# ============================================================================
# Intelligent document routing - automatically selects optimal parser(s)
# based on document characteristics (images, tables, complexity)

# Enable/Disable Smart Router
SMART_ROUTER_ENABLED=true  # Master switch for smart routing

# Document Analysis Thresholds
SMART_ROUTER_IMAGE_THRESHOLD=3  # Min images to trigger Vision API
SMART_ROUTER_MIN_IMAGE_SIZE_BYTES=10000  # Ignore tiny images (<10KB)
SMART_ROUTER_DETECT_SCANNED_PDF=true  # Auto-detect scanned/image-only PDFs
SMART_ROUTER_SCANNED_TEXT_THRESHOLD=100  # Chars/page to consider "scanned" (<100)

# Routing Strategy
SMART_ROUTER_PREFER_VISION_FOR_CHARTS=true  # Use Vision when images detected
SMART_ROUTER_ALWAYS_USE_DOCLING=true  # Always extract text with Docling
SMART_ROUTER_ENABLE_PARALLEL_PARSING=false  # Parse Docling + Vision concurrently (experimental)

# Cost Controls for Vision in Smart Router
SMART_ROUTER_MAX_IMAGES_FOR_VISION=10  # Override Vision's default per-doc limit
SMART_ROUTER_SKIP_VISION_IF_EXPENSIVE=true  # Skip Vision if >max images
SMART_ROUTER_SKIP_VISION_IF_NO_TEXT=false  # Process image-only docs with Vision

# Result Merging Strategy
SMART_ROUTER_CONFIDENCE_WEIGHT_TEXT=0.7  # Weight for Docling confidence
SMART_ROUTER_CONFIDENCE_WEIGHT_VISION=0.3  # Weight for Vision confidence
SMART_ROUTER_INTERLEAVE_VISION_TEXT=false  # Inject descriptions at positions vs append
SMART_ROUTER_VISION_TEXT_SEPARATOR="\n\n---\n\n## Chart Interpretations\n\n"  # Separator

# Fallback Behavior
SMART_ROUTER_FALLBACK_TO_DOCLING=true  # Use Docling if Vision fails/disabled
SMART_ROUTER_FAIL_IF_ALL_PARSERS_FAIL=true  # Return error if all parsers fail

# Performance & Logging
SMART_ROUTER_LOG_ROUTING_DECISIONS=true  # Log which parser(s) selected
SMART_ROUTER_LOG_ANALYSIS_RESULTS=true  # Log document analysis details
SMART_ROUTER_ENABLE_METRICS=true  # Track routing statistics

# Smart Router Usage:
#   Set PARSER_PRIMARY="smart" to enable intelligent routing
#   Documents with 3+ images → Docling + Vision (combined)
#   Text-only documents → Docling only
#   Image-only documents → Vision only
#   Respects all cost controls and fallback gracefully

# ============================================================================
# Production Settings (Override in production)
# ============================================================================

# In production, set these values:
# DEBUG=False
# LOG_LEVEL=WARNING
# CROSS_ENCODER_DEVICE=cuda  # If GPU available
# EMBEDDING_DEVICE=cuda  # If GPU available
# ENABLE_RERANKING_METRICS=True
# SENTRY_DSN=https://your-sentry-dsn
