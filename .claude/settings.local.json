{
  "permissions": {
    "allow": [
      "Bash(python -m pytest:*)",
      "Bash(python:*)",
      "Bash(pip install:*)",
      "mcp__ide__getDiagnostics",
      "Bash(python3 -m pytest:*)",
      "Bash(pytest:*)",
      "Bash(make test:*)"
    ],
    "deny": [],
    "ask": []
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx tsx .claude/hooks/skill-activation-prompt.ts"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/post-tool-use-tracker.sh"
          }
        ]
      }
    ]
  }
}
