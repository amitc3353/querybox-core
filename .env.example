# Database Configuration
DATABASE_URL=postgresql://querybox:querybox_dev_2024@localhost:5432/querybox_core

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Storage Configuration (MinIO/S3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=querybox-documents

# AI/Embeddings
OPENAI_API_KEY=sk-your-openai-api-key-here

# Security
API_KEY=dev-key-12345
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# File Upload Limits
MAX_FILE_SIZE=31457280  # 30MB in bytes
LARGE_FILE_THRESHOLD=10485760  # 10MB in bytes

# Processing Queue
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=QueryBox Core

# Environment
ENVIRONMENT=development
DEBUG=true

# Monitoring (Optional)
SENTRY_DSN=https://d1f802ca512793bb778939ae1d8c3573@o4510365305208832.ingest.us.sentry.io/4510365311434752

# ============================================================================
# METADATA EXTRACTION CONFIGURATION (Step 6)
# ============================================================================

# Docling Service Configuration
DOCLING_SERVICE_URL=http://localhost:8080
DOCLING_API_KEY=
DOCLING_REQUEST_TIMEOUT=30
DOCLING_RETRY_ATTEMPTS=3
DOCLING_RETRY_DELAY=1.0

# File Processing Limits
DOCLING_MAX_FILE_SIZE_MB=100
DOCLING_MAX_PAGES=1000

# Processing Options
DOCLING_QUALITY_LEVEL=balanced  # fast, balanced, high_quality
DOCLING_EXTRACT_IMAGES=true
DOCLING_EXTRACT_TABLES=true
DOCLING_OCR_ENABLED=true
DOCLING_LANGUAGE_DETECTION=true

# Fallback Configuration
DOCLING_FALLBACK_ENABLED=true

# Metadata Extraction Settings
METADATA_EXTRACTION_ENABLED=true
METADATA_EXTRACTION_TIMEOUT=30
METADATA_MAX_FILE_SIZE_MB=100
MIN_TEXT_QUALITY_SCORE=0.3
MIN_CONFIDENCE_SCORE=0.5

# Feature Flags
LANGUAGE_DETECTION_ENABLED=true
DOCUMENT_CLASSIFICATION_ENABLED=true
QUALITY_ASSESSMENT_ENABLED=true

# ============================================================================
# CHUNKING CONFIGURATION (Step 9.1)
# ============================================================================

# Token-based Chunking (BGE-M3 optimized)
CHUNK_TARGET_TOKENS=512         # Optimal chunk size for BGE-M3 embeddings
CHUNK_MAX_TOKENS=600            # Hard limit (prevents truncation, model max=8192)
CHUNK_MIN_TOKENS=100            # Minimum viable chunk size
CHUNK_OVERLAP_TOKENS=50         # Token overlap between chunks (~10%)

# NLP Configuration
USE_SPACY=true                  # Use spaCy for sentence splitting (fallback to NLTK if false)
SPACY_MODEL=en_core_web_sm      # spaCy model for English text

# Quality Thresholds
MIN_QUALITY_SCORE=0.6           # Warn if chunk quality below this threshold
TARGET_QUALITY_SCORE=0.8        # Target quality score for optimal chunking

# Additional Chunking Options
PRESERVE_PARAGRAPHS=true        # Prefer paragraph boundaries for chunk breaks
EXTRACT_METADATA=true           # Extract document structure metadata