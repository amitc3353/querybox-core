# Database Configuration
DATABASE_URL=postgresql://querybox:querybox_dev_2024@localhost:5432/querybox_core

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Storage Configuration (MinIO/S3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=querybox-documents

# AI/Embeddings
OPENAI_API_KEY=sk-your-openai-api-key-here

# Security
API_KEY=dev-key-12345
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# File Upload Limits
MAX_FILE_SIZE=31457280  # 30MB in bytes
LARGE_FILE_THRESHOLD=10485760  # 10MB in bytes

# Processing Queue
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=QueryBox Core

# Environment
ENVIRONMENT=development
DEBUG=true

# Monitoring (Optional)
SENTRY_DSN=your-sentry-dsn-here

# ============================================================================
# METADATA EXTRACTION CONFIGURATION (Step 6)
# ============================================================================

# Docling Service Configuration
DOCLING_SERVICE_URL=http://localhost:8080
DOCLING_API_KEY=
DOCLING_REQUEST_TIMEOUT=30
DOCLING_RETRY_ATTEMPTS=3
DOCLING_RETRY_DELAY=1.0

# File Processing Limits
DOCLING_MAX_FILE_SIZE_MB=100
DOCLING_MAX_PAGES=1000

# Processing Options
DOCLING_QUALITY_LEVEL=balanced  # fast, balanced, high_quality
DOCLING_EXTRACT_IMAGES=true
DOCLING_EXTRACT_TABLES=true
DOCLING_OCR_ENABLED=true
DOCLING_LANGUAGE_DETECTION=true

# Fallback Configuration
DOCLING_FALLBACK_ENABLED=true

# Metadata Extraction Settings
METADATA_EXTRACTION_ENABLED=true
METADATA_EXTRACTION_TIMEOUT=30
METADATA_MAX_FILE_SIZE_MB=100
MIN_TEXT_QUALITY_SCORE=0.3
MIN_CONFIDENCE_SCORE=0.5

# Feature Flags
LANGUAGE_DETECTION_ENABLED=true
DOCUMENT_CLASSIFICATION_ENABLED=true
QUALITY_ASSESSMENT_ENABLED=true