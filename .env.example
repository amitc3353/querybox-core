# Database Configuration
DATABASE_URL=postgresql://querybox:password@localhost:5432/querybox

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Storage Configuration (MinIO/S3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=querybox-documents

# AI/Embeddings
OPENAI_API_KEY=sk-your-openai-api-key-here

# Security
API_KEY=dev-key-12345
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# File Upload Limits
MAX_FILE_SIZE=31457280  # 30MB in bytes
LARGE_FILE_THRESHOLD=10485760  # 10MB in bytes

# Processing Queue
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=QueryBox Core

# Environment
ENVIRONMENT=development
DEBUG=true

# Monitoring (Optional)
SENTRY_DSN=your-sentry-dsn-here